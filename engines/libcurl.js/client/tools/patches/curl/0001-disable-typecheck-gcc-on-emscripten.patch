From 7babedb179f32ea3f944bdd0eb01127ff40c4e06 Mon Sep 17 00:00:00 2001
From: ading2210 <ading2019@gmail.com>
Date: Mon, 1 Dec 2025 11:05:40 -0800
Subject: [PATCH 1/2] disable typecheck-gcc on emscripten

---
 include/curl/curl.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/curl/curl.h b/include/curl/curl.h
index b904e49..a3e54a4 100644
--- a/include/curl/curl.h
+++ b/include/curl/curl.h
@@ -3350,7 +3350,7 @@ CURL_EXTERN CURLcode curl_easy_ssls_export(CURL *curl,
 #if ((defined(__GNUC__) && defined(__GNUC_MINOR__) && \
       ((__GNUC__ > 4) || (__GNUC__ == 4 && __GNUC_MINOR__ >= 3))) || \
     (defined(__clang__) && __clang_major__ >= 14)) && \
-    !defined(__cplusplus) && !defined(CURL_DISABLE_TYPECHECK)
+    !defined(__cplusplus) && !defined(__EMSCRIPTEN__) && !defined(CURL_DISABLE_TYPECHECK)
 #include "typecheck-gcc.h"
 #else
 #if defined(__STDC__) && (__STDC__ >= 1)
